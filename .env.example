# Anthropic API key for the LLM reasoning layer (slot extraction + FAQ answers)
ANTHROPIC_API_KEY=your_api_key_here

# Model to use for chat completions
CLAUDE_MODEL=claude-sonnet-5

# SQLite database path (mock Grievance Management System store)
DATABASE_URL=sqlite:///./app/data/grievance.db

# SMTP settings for notification emails (mocked/logged in this prototype)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@gbu.ac.in
SMTP_PASSWORD=your_smtp_password
NOTIFY_FROM_EMAIL=notifications@gbu.ac.in
